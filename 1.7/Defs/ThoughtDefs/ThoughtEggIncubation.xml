<Defs>
  <!-- Shared thought templates -->

  <!-- Standard incubation mood thought -->

  <ThoughtDef Abstract="True" Name="EggIncubationThoughtBase">
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <nullifyingTraits>
      <li>Masochist</li>
	    <li>Nymphomaniac</li>
      <li>Zoophile</li>
      <li>TentacleLover</li>
    </nullifyingTraits>
    <nullifyingPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">AmorHostPresence_Honorable</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AmorHostPresence_Abhorrent</li>
    </nullifyingPrecepts>
    <stages>
      <li>
        <label>incubating egg</label>
        <baseMoodEffect>0</baseMoodEffect>
        <visible>false</visible>
      </li>
      <li>
        <label>egg hatched</label>
        <description>I felt something hatch inside me!</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>it's getting bigger</label>
        <description>I feel so bloated, and I can see something moving under my skin!</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>what is happening to me!</label>
        <description>It's moving my organs around! What is it doing? I want it out!</description>
        <baseMoodEffect>-18</baseMoodEffect>
      </li>
      <li>
        <label>TAKE IT OUT!</label>
        <description>TAKE IT OUT! TAKE IT OUT! TAKE IT OUT!</description>
        <baseMoodEffect>-30</baseMoodEffect>
      </li>
      <li>
        <label>incubating egg</label>
        <baseMoodEffect>0</baseMoodEffect>
        <visible>false</visible>
      </li>
      <li>
        <label>egg hatched</label>
        <description>I felt something hatch inside me!</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>it's getting bigger</label>
