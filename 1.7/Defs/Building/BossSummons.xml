<Defs>

	<ThingDef ParentName="BuildingBase" Name="BossSummonBase" Abstract="True">
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<buildingTags>
				<li>Tentacles</li>
			</buildingTags>
		</building>
		<designatorDropdown>BossSummonBuildings</designatorDropdown>
		<designationCategory>Tentacles</designationCategory>
		<uiOrder>2460</uiOrder>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>8000</WorkToBuild>
			<Mass>25</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<size>(2,2)</size>
		<costList>
			<HardResin>75</HardResin>
			<SoftResin>25</SoftResin>
			<TentacleSlime>5</TentacleSlime>
			<TentacleCatalyst>1</TentacleCatalyst>
		</costList>
		<killedLeavings>
			<HardResin>5</HardResin>
			<SoftResin>3</SoftResin>
		</killedLeavings>
		<researchPrerequisites>
			<li>ATLarvaAdvanced</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Usable">
				<useJob>TriggerObject</useJob>
				<useDuration>900</useDuration>
				<floatMenuFactionIcon>Tentacles</floatMenuFactionIcon>
			</li>
			<li Class="CompProperties_UseEffectDestroySelf">
				<delayTicks>120</delayTicks>
				<spawnKilledLeavings>true</spawnKilledLeavings>
				<effecterDef>ButcherFlesh</effecterDef>
			</li>
		</comps>
		<tickerType>Normal</tickerType>
		<filthLeaving>Filth_Blood</filthLeaving>
	</ThingDef>
	
	<ThingDef ParentName="BossSummonBase">
		<defName>BossSummonFeralSwarm</defName>
		<graphicData>
			<texPath>Things/Buildings/Summoners/TentacleSummoner</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(1.1, 0.75, 1.1</volume>
			</shadowData>
		</graphicData>
		<costList>
			<Steel>50</Steel>
			<HardResin>25</HardResin>
			<SoftResin>10</SoftResin>
			<TentacleSlime>1</TentacleSlime>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<killedLeavings>
			<HardResin>2</HardResin>
			<SoftResin>1</SoftResin>
			<ChunkSlagSteel>2</ChunkSlagSteel>
		</killedLeavings>
		<comps>
			<li Class="AmorTentaculum.CompProperties_Useable_OrganicCallBossgroup">
				<bossgroupDef>Apocriton</bossgroupDef>
				<effecterDef>SanguophageMeeting</effecterDef>
				<prepareEffecterDef>Surgery</prepareEffecterDef>
				<unlockedLetterLabelKey>LetterLabelTentacleBossgroupCallerUnlocked</unlockedLetterLabelKey>
				<unlockedLetterTextKey>LetterTentacleBossgroupCallerUnlocked</unlockedLetterTextKey>
				<delayTicks>120</delayTicks>
			</li>
		</comps>
	</ThingDef>

