<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<MemeDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorTentaculumSupremacy</defName>
		<label>Amor Worship</label>
		<description>The Amor Tentaculum are meant to live and die alongside us. Open your arms and legs in acceptance of their blessings.</description>
		<iconPath>Ideo/Memes/AmorTentacle_Meme</iconPath>
		<groupDef>Misc</groupDef>
		<impact>2</impact>
		<generalRules>
			<rulesStrings>
				<li>memeAdjective->tentacular</li>
				<li>memeCreed->Amor Tentaculum</li>
				<li>memeConcept->tentacles</li>
			</rulesStrings>
		</generalRules>
		<requireOne>
			<li>
				<li>AmorTentaculum_Accepted</li>
			</li>
			<li>
				<li>AmorHostPresence_Honorable</li>
			</li>
		</requireOne>
		<symbolPacks>
			<li>
				<ideoName>Amor Tentaculum</ideoName>
				<theme>tentacles</theme>
				<adjective>tentacular</adjective>
				<member>tentacle devotee</member>
			</li>
		</symbolPacks>
	</MemeDef>

	<IssueDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorTentaculum</defName>
		<label>Amor Tentaculum</label>
		<iconPath>Ideo/Precepts/AmorTentacle_Precept</iconPath>
	</IssueDef>

	<IssueDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence</defName>
		<label>Amor Host Presence</label>
		<iconPath>Ideo/Precepts/AmorHostPresence_Precept</iconPath>
	</IssueDef>

	<HistoryEventDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorTentaculumCreatureKilled</defName>
		<label>Amor Tentaculum creature killed</label>
	</HistoryEventDef>

	<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorTentaculum_Accepted</defName>
		<issue>AmorTentaculum</issue>
		<label>Accepted</label>
		<description>Only fools would despise the creatures of Amor Tentaculum; they are useful to the colony in... many ways</description>
		<impact>Medium</impact>
		<displayOrderInIssue>10</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<associatedMemes>
			<li>AmorTentaculumSupremacy</li>
		</associatedMemes>
		<requiredMemes>
			<li>AmorTentaculumSupremacy</li>
		</requiredMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>grabberAThought_Accepted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>grabberMThought_Accepted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>grabberPThought_Accepted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>grabberVThought_Accepted</thought>
			</li>
		</comps>
	</PreceptDef>

	<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorTentaculum_Despised</defName>
		<issue>AmorTentaculum</issue>
		<label>despised</label>
		<description>The creatures of Amor Tentaculum are an abomination, a plague that deserves to be exterminated.</description>
		<impact>Low</impact>
		<displayOrderInIssue>20</displayOrderInIssue>
		<displayOrderInImpact>100</displayOrderInImpact>
		<comps>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>AmorTentaculumCreatureKilled</eventDef>
				<thought>AmorTentaculum_Despised</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorTentaculum_Despised</defName>
		<durationDays>1</durationDays>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>Amor Tentaculum creature slain</label>
				<description>I killed one of those filthy tentacles. Good.</description>
				<baseMoodEffect>4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Abhorrent</defName>
		<issue>AmorHostPresence</issue>
		<label>abhorrent</label>
		<description>Hosts of the Amor are a blight upon the world. we should not tolerate their presence.</description>
		<impact>Low</impact>
		<displayOrderInIssue>40</displayOrderInIssue>
		<displayOrderInImpact>1000</displayOrderInImpact>
		<defaultSelectionWeight>1</defaultSelectionWeight>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>AmorHostPresence_Abhorrent_HostsInColony</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>AmorHostPresence_Abhorrent_NoHostsInColony</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>StrechS_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>StrechA_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>StrechV_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>QueenEggIncubationThought_Abhorrent</thought>
			</li>
					<li Class="PreceptComp_SituationalThought">
				<thought>BaronessEggIncubationThought_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>NymphEggIncubationThought_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>BaronEggIncubationThought_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>RogueEggIncubationThought_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>KnightEggIncubationThought_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>ServantEggIncubationThought_Abhorrent</thought>
			</li>
		</comps>
	</PreceptDef>

	<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Acceptable</defName>
		<issue>AmorHostPresence</issue>
		<label>acceptable</label>
		<description>The presence of hosts is a normal, unremarkable part of life.</description>
		<impact>Low</impact>
		<displayOrderInIssue>10</displayOrderInIssue>
		<defaultSelectionWeight>1</defaultSelectionWeight>
	</PreceptDef>
<!-- TODO EXALTED -->
	<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Honorable</defName>
		<issue>AmorHostPresence</issue>
		<label>honorable</label>
		<description>Being a Host to the Amor is a not just an honor: it's a duty. what are wombs for if not to be filled with tentacles?</description>
		<impact>Medium</impact>
		<displayOrderInIssue>0</displayOrderInIssue>
		<displayOrderInImpact>1000</displayOrderInImpact>
		<defaultSelectionWeight>1</defaultSelectionWeight>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>AmorHostPresence_Honorable_HostsInColony</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>AmorHostPresence_Honorable_NoHostsInColony</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>AmorHostPresence_Honorable_NonHostsInColony</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>StrechS_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>StrechA_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>StrechV_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>QueenEggIncubationThought_Honorable</thought>
			</li>
					<li Class="PreceptComp_SituationalThought">
				<thought>BaronessEggIncubationThought_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>NymphEggIncubationThought_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>BaronEggIncubationThought_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>RogueEggIncubationThought_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>KnightEggIncubationThought_Honorable</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>ServantEggIncubationThought_Honorable</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Abhorrent_HostsInColony</defName>
		<thoughtClass>Thought_Situational</thoughtClass>
		<workerClass>AmorTentaculum.ThoughtWorker_AmorHostsPresent</workerClass>
		<stages>
			<li>
				<label>hosts in colony</label>
				<description>We're keeping hosts among us. I can't trust my back when these freaks are around</description>
				<baseMoodEffect>-3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Abhorrent_NoHostsInColony</defName>
		<thoughtClass>Thought_Situational</thoughtClass>
		<workerClass>AmorTentaculum.ThoughtWorker_AmorNoHostsPresent</workerClass>
		<stages>
			<li>
				<label>no hosts in colony</label>
				<description>The colony is clean of the Tainted ones. I feel at ease.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Honorable_HostsInColony</defName>
		<thoughtClass>Thought_Situational</thoughtClass>
		<workerClass>AmorTentaculum.ThoughtWorker_AmorHostsPresent</workerClass>
		<stages>
			<li>
				<label>hosts in colony</label>
				<description>Amor Hosts fill our ranks. the more holes filled with tentacles, the better.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Honorable_NoHostsInColony</defName>
		<thoughtClass>Thought_Situational</thoughtClass>
		<workerClass>AmorTentaculum.ThoughtWorker_AmorNoHostsPresent</workerClass>
		<stages>
			<li>
				<label>no hosts in colony</label>
				<description>We are untouched by the Amor. What's even the point of living if nobody is getting fucked by tentacles?</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

	<ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>AmorHostPresence_Honorable_NonHostsInColony</defName>
		<thoughtClass>Thought_Situational</thoughtClass>
		<workerClass>AmorTentaculum.ThoughtWorker_AmorNonHostsPresent</workerClass>
		<stages>
			<li>
				<label>non-hosts in colony</label>
				<description>People in the colony without 'guests' within are an eyesore. We should fix that when we get the chance.</description>
				<baseMoodEffect>-2</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
</Defs>
