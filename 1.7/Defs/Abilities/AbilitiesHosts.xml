	<DamageDef>
		<defName>Cummies</defName>
		<label>cum</label>
		<workerClass>DamageWorker_Extinguish</workerClass>
		<canInterruptJobs>false</canInterruptJobs>
		<makesBlood>false</makesBlood>
		<defaultDamage>999999</defaultDamage>
		<hediff>CoveredInTentCum</hediff>
		<explosionCellFleck>BlastExtinguisher</explosionCellFleck>
		<explosionColorEdge>(203,40,227,0.5)</explosionColorEdge>
		<soundExplosion>Explosion_Stun</soundExplosion>
		<harmsHealth>false</harmsHealth>
		<combatLogRules>Damage_Cummies</combatLogRules>
		<consideredHelpful>true</consideredHelpful>
	</DamageDef>

	<HediffDef>
		<defName>CoveredInTentCum</defName>
		<description>Covered in tentacle slime-cum.</description>
		<label>covered in slime-cum</label>
		<hediffClass>Hediff_CoveredInFirefoam</hediffClass>
		<stages>
			<li>
				<mentalStateGivers>
					<li>
						<mentalState>RandomRape</mentalState>
						<mtbDays>0.1</mtbDays>
					</li>
				</mentalStateGivers>
				<statFactors>
					<Flammability>0</Flammability>
					<MoveSpeed>-0.5</MoveSpeed>
				</statFactors>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>1900</disappearsAfterTicks>
			</li>
		</comps>
	</HediffDef>

	<RulePackDef>
		<defName>Damage_Cummies</defName>
		<rulePack>
			<rulesStrings>
				<li>damaged_past->cummed</li>
				<li>damaged_past->slimed</li>
				<li>damaged_past->cum coated</li>
				<li>destroyed_past->cummed off</li>
