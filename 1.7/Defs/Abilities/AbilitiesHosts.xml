<Defs>
	
	<!-- Pawn Abilities -->

	<!-- Tentacle Resource Abilities -->
	
	<!-- Tentacle Ingest -->
	<AbilityDef ParentName="AbilityTouchBase">
		<defName>TentacleIngest</defName>
		<label>Ingest tentacle</label>
		<description>Ingests the selected Amor Internum.</description>
		<iconPath>Abilities/ButtVore</iconPath>
		<category>Tentacle</category>
		<targetRequired>True</targetRequired>
		<stunTargetWhileCasting>true</stunTargetWhileCasting>
		<cooldownTicksRange>5</cooldownTicksRange>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbilityTouch</verbClass>
			<drawAimPie>false</drawAimPie>
			<range>1</range>
			<warmupTime>2</warmupTime>
			<soundCast>AcidSpray_Resolve</soundCast>
			<targetParams>
				<canTargetAnimals>true</canTargetAnimals>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<targetHasAnyOfHediffs>
					<li>vagrancy</li>
				</targetHasAnyOfHediffs>
				<casterHasAnyOfHediffs>
					<li>TentacleStorage</li>
				</casterHasAnyOfHediffs>
				<casterHasNoneOfHediffs>
					<li>FullOfTentacles</li>
				</casterHasNoneOfHediffs>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityResourceCost">
				<resourceCost>-0.01</resourceCost>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityGiveMultipleHediffs">
				<hediffsToGive>
					<li>
						<hediffDef>TentacleSacrifice</hediffDef>
						<applyToTarget>true</applyToTarget>
						<replaceExisting>false</replaceExisting>
						<bodyParts>
							<li>Brain</li>
						</bodyParts>
					</li>
				</hediffsToGive>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>Heart</fleckDef>
			</li>
			<li Class="EBSGFramework.CompProperties_InstantKill">
				<filthReplacement>FilthSlime</filthReplacement>
			</li>
		</comps>
	</AbilityDef>

	<!-- Tentacle Expel -->
	<AbilityDef ParentName="AbilityTouchBase">
		<defName>TentacleExpel</defName>
		<label>Expel tentacle</label>
		<description>Expels an Amor Internum tentacle from the Host.\n\nWARNING: This is dangerous if the pawn runs out of stored tentacles!</description>
		<iconPath>Abilities/ButtVore</iconPath>
		<category>Tentacle</category>
		<cooldownTicksRange>5</cooldownTicksRange>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbilityTouch</verbClass>
			<range>5</range>
			<warmupTime>2</warmupTime>
			<requireLineOfSight>True</requireLineOfSight>
			<targetParams>
				<canTargetLocations>True</canTargetLocations>
			</targetParams>
			<soundCast>FireSpew_Warmup</soundCast>
		</verbProperties>
		<comps>
			<li Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<casterHasAnyOfHediffs>
					<li>TentacleStorage</li>
				</casterHasAnyOfHediffs>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityResourceCost">
				<resourceCost>0.01</resourceCost>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>Mote_NoHeart</fleckDef>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilitySpawnPawnKind">
				<pawnKind>TInternal</pawnKind>
				<count>1</count>
				<inCreatorFaction>True</inCreatorFaction>
			</li>
		</comps>
	</AbilityDef>

	<!-- Tentacle Transfer -->
	<AbilityDef ParentName="AbilityTouchBase">
		<defName>TentacleTransfer</defName>
		<label>Transfer tentacle</label>
		<description>Transfer an Amor Internum tentacle from one Host to another.  With a sloppy kiss.\n\nWARNING: This is dangerous if the pawn runs out of stored tentacles!</description>
		<iconPath>Abilities/MouthVore</iconPath>
		<category>Tentacle</category>
		<cooldownTicksRange>5</cooldownTicksRange>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbilityTouch</verbClass>
			<range>5</range>
			<warmupTime>2</warmupTime>
			<requireLineOfSight>True</requireLineOfSight>
			<targetParams>
				<canTargetLocations>True</canTargetLocations>
			</targetParams>
			<soundCast>FireSpew_Warmup</soundCast>
		</verbProperties>
		<comps>
			<li Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<casterHasAnyOfHediffs>
					<li>TentacleStorage</li>
				</casterHasAnyOfHediffs>
				<targetHasAnyOfHediffs>
					<li>TentacleStorage</li>
				</targetHasAnyOfHediffs>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityResourceCost">
				<resourceCost>0.01</resourceCost>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityGiveResource">
				<amount>0.01</amount>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>Heart</fleckDef>
			</li>
		</comps>
	</AbilityDef>

	<AbilityDef>
		<defName>BirthMatronEgg</defName>
		<label>Lay Amor Queen egg</label>
		<description>Begin laying a massive Amor Queen egg.</description>
		<iconPath>Abilities/OviVag</iconPath>
		<jobDef>CastAbilityOnThing</jobDef>
		<targetRequired>False</targetRequired>
		<canUseAoeToGetTargets>False</canUseAoeToGetTargets>
		<category>Tentacle</category>
		<stunTargetWhileCasting>True</stunTargetWhileCasting>
