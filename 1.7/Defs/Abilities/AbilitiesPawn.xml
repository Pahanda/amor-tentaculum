					<li>FullOfTentacles</li>
				</casterHasNoneOfHediffs>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityResourceCost">
				<resourceCost>-0.01</resourceCost>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="EBSGFramework.CompProperties_InstantKill">
				<filthReplacement>FilthSlime</filthReplacement>
			</li>
			<li Class="EBSGFramework.CompProperties_AbilityGiveMultipleHediffs">
				<hediffsToGive>
					<li>
