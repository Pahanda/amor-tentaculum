<Defs>

	<ScenarioDef ParentName="ScenarioBase">
		<defName>TentacleStart</defName>
		<label>The Amor Cultivator</label>
		<description>You knew you wanted to breed and host the Amor Tentaculum species ever since you found that research file. You bought a one-way trip with Daddy's money to a rimworld, an Amor queen egg, and some specimens.</description>
		<scenario>
			<summary>Two tentacle lovers and some pet tentacles.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>PlayerColony</factionDef>
			</playerFaction>
			<parts>

				<!-- Game start dialog -->
				<li Class="ScenPart_GameStartDialog">
					<def>GameStartDialog</def>
					<text>You knew you wanted to breed and host the Amor Tentaculum species ever since you found that research file. You bought a one-way trip with Daddy's money to a rimworld, an Amor queen egg, and some specimens.</text>
					<closeSound>GameStartSting</closeSound>
				</li>

				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>3</pawnCount>
					<pawnChoiceCount>5</pawnChoiceCount>
				</li>

				<!-- Player starting stuff spawn method -->

				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<visible>false</visible>
					<method>DropPods</method>
				</li>

				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<animalKind>TentacleProducer</animalKind>
					<count>2</count>
				</li>
				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<animalKind>TentacleGrazer</animalKind>
					<count>1</count>
				</li>
				<li Class="ScenPart_ForcedTrait">
					<def>ForcedTrait</def>
					<chance>1</chance>
					<context>PlayerStarter</context>
					<trait>TentacleLover</trait>
				</li>

				<!-- Player starting things -->
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>SoftResin</thingDef>
					<count>250</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>HardResin</thingDef>
					<count>500</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MealSurvivalPack</thingDef>
					<count>40</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>AmorQueenEgg</thingDef>
					<count>1</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>25</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>55</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Steel</thingDef>
					<count>900</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Gun_PumpShotgun</thingDef>
				</li>

				<li Class="ScenPart_StartingResearch">
					<def>StartingResearch</def>
					<project>ATCore</project>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

</Defs>