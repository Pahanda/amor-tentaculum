<Defs>

	<ThingDef Abstract="True" Name="ProcessingPodBase" ParentName="BuildingBase">
		<thingClass>Building_TentaclePod</thingClass>
		<containedPawnsSelectable>true</containedPawnsSelectable>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,2)</drawSize>
			<shadowData>
				<volume>(3, 2, 1.9)</volume>
			</shadowData>
		</graphicData>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<buildingTags>
				<li>Tentacles</li>
			</buildingTags>
			<workTableRoomRole>Laboratory</workTableRoomRole>
		</building>
		<designationCategory>Tentacles</designationCategory>
		<uiOrder>2430</uiOrder>
		<canOverlapZones>false</canOverlapZones>
		<size>(3,2)</size>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<statBases>
			<Mass>25</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
	</ThingDef>

	<ThingDef ParentName="ProcessingPodBase">
		<defName>Building_RecyclingPod</defName>
		<thingClass>Building_RecyclingPod</thingClass>
		<graphicData>
			<texPath>Things/Buildings/Pods/RecyclerPod</texPath>
		</graphicData>
		<statBases>
			<WorkToBuild>8000</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
		</statBases>
		<costList>
			<HardResin>200</HardResin>
			<SoftResin>25</SoftResin>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<researchPrerequisites>
			<li>ATStructBasic</li>
		</researchPrerequisites>
		<building>
			<subcoreScannerFixedIngredients>
				<li>
					<filter>
						<thingDefs>
							<li>TentacleSlime</li>
						</thingDefs>
					</filter>
					<count>5</count>
				</li>
			</subcoreScannerFixedIngredients>
			<subcoreScannerOutputDef>TentacleCatalyst</subcoreScannerOutputDef>
			<subcoreScannerStartEffect>ButcherFlesh</subcoreScannerStartEffect>
			<subcoreScannerWorking>Recipe_Surgery</subcoreScannerWorking>
			<subcoreScannerComplete>Execute_Cut</subcoreScannerComplete>
			<destroyBrain>true</destroyBrain>
			<subcoreScannerHediff>PawnRecycled</subcoreScannerHediff>
		</building>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	</ThingDef>

	<ThingDef ParentName="ProcessingPodBase">
		<defName>Building_TransformationPod</defName>
		<thingClass>Building_TransformationPod</thingClass>
		<graphicData>
			<texPath>Things/Buildings/Pods/TransformationPod</texPath>
		</graphicData>
		<statBases>
			<WorkToBuild>8000</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
		</statBases>
		<costList>
			<HardResin>200</HardResin>
			<SoftResin>25</SoftResin>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<researchPrerequisites>
			<li>ATSummonFeral</li>
		</researchPrerequisites>
		<building>
			<subcoreScannerFixedIngredients>
				<li>
					<filter>
						<thingDefs>
							<li>TentacleSlime</li>
						</thingDefs>
					</filter>
					<count>50</count>
				</li>
				<li>
					<filter>
						<thingDefs>
							<li>SoftResin</li>
						</thingDefs>
					</filter>
					<count>100</count>
				</li>
			</subcoreScannerFixedIngredients>
			<subcoreScannerTicks>30000</subcoreScannerTicks>
			<subcoreScannerStartEffect>ButcherFlesh</subcoreScannerStartEffect>
			<subcoreScannerWorking>Recipe_Surgery</subcoreScannerWorking>
			<subcoreScannerComplete>Execute_Cut</subcoreScannerComplete>
			<destroyBrain>false</destroyBrain>
		</building>
		<modExtensions>
			<li Class="TransformationPodExtension">
				<recipes>
					<li>
						<larva>BossLarvaBrewer</larva>
						<pawnKind>TentacleBrewer</pawnKind>
					</li>
					<li>
						<larva>BossLarvaValkyrie</larva>
						<pawnKind>TentacleValkyrie</pawnKind>
					</li>
					<li>
						<larva>BossLarvaDefender</larva>
						<pawnKind>TentacleDefender</pawnKind>
					</li>
					<li>
						<larva>BossLarvaWarWomb</larva>
						<pawnKind>TentacleWarWomb</pawnKind>
					</li>
				</recipes>
			</li>
		</modExtensions>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	</ThingDef>

</Defs>