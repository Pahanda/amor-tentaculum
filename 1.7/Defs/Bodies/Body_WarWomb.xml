<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Tentaculum body: WarWombBody -->
  <BodyDef>
    <defName>WarWombBody</defName>
    <corePart>
      <def>Shell</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Elytra</def>
          <customLabel>left elytra</customLabel>
          <coverage>0.05</coverage>
        </li>
        <li>
          <def>Elytra</def>
          <customLabel>right elytra</customLabel>
          <coverage>0.05</coverage>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Pronotum</def>
          <coverage>0.22</coverage>
          <height>Top</height>
          <parts>
            <li>
              <def>TentacleBeastHead</def>
              <coverage>0.90</coverage>
              <groups>
                <li>FullHead</li>
                <li>UpperHead</li>
              </groups>
              <parts>
                <li>
                  <def>Brain</def>
                  <coverage>0.12</coverage>
                  <depth>Inside</depth>
                  <groups>
                    <li>FullHead</li>
                    <li>UpperHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>left sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                  <flipGraphic>true</flipGraphic>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>right sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>upper left sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>upper right sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>TentacleBeastMouth</def>
                  <coverage>0.08</coverage>
                  <groups>
                    <li>Mouth</li>
                  </groups>
                </li>
                <li>
                  <def>Tentacle</def>
                  <customLabel>Upper right mass of tentacles</customLabel>
                  <coverage>0.09</coverage>
                  <height>Top</height>
                  <groups>
                    <li>WarWombFrontTentacles</li>
                  </groups>
                </li>
                <li>
                  <def>Tentacle</def>
                  <customLabel>Upper left mass of tentacles</customLabel>
                  <coverage>0.09</coverage>
                  <height>Top</height>
                  <flipGraphic>true</flipGraphic>
                  <groups>
                    <li>WarWombFrontTentacles</li>
                  </groups>
                </li>
                <li>
                  <def>Tentacle</def>
                  <customLabel>Bottom right mass of tentacles</customLabel>
                  <coverage>0.09</coverage>
                  <height>Bottom</height>
                  <groups>
                    <li>WarWombFrontTentacles</li>
                  </groups>
                </li>
                <li>
                  <def>Tentacle</def>
                  <customLabel>Bottom left mass of tentacles</customLabel>
                  <coverage>0.09</coverage>
                  <height>Bottom</height>
                  <flipGraphic>true</flipGraphic>
                  <groups>
                    <li>WarWombFrontTentacles</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>LargeTentacleLeg</def>
          <customLabel>front left leg</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>LargeTentacleLeg</def>
          <customLabel>front right leg</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <flipGraphic>true</flipGraphic>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>LargeTentacleLeg</def>
          <customLabel>middle left leg</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>LargeTentacleLeg</def>
          <customLabel>middle right leg</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <flipGraphic>true</flipGraphic>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>LargeTentacleLeg</def>
          <customLabel>rear left leg</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>LargeTentacleLeg</def>
          <customLabel>rear right leg</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <flipGraphic>true</flipGraphic>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>Torso</def>
          <customLabel>upper torso</customLabel>
          <coverage>0.16</coverage>
          <height>Top</height>
          <depth>Outside</depth>
          <groups>
            <li>Torso</li>
          </groups>
          <parts>
            <li>
              <def>Ribcage</def>
              <coverage>0.10</coverage>
              <depth>Inside</depth>
            </li>
            <li>
              <def>Spine</def>
              <coverage>0.06</coverage>
              <depth>Inside</depth>
            </li>
            <li>
              <def>Neck</def>
              <coverage>0.12</coverage>
              <height>Top</height>
              <groups>
                <li>Neck</li>
              </groups>
              <parts>
                <li>
                  <def>Head</def>
                  <coverage>0.80</coverage>
                  <groups>
                    <li>UpperHead</li>
                    <li>FullHead</li>
                    <li>HeadAttackTool</li>
                  </groups>
                  <parts>
                    <li>
                      <def>Brain</def>
                      <coverage>0.144</coverage>
                      <depth>Inside</depth>
                    </li>
                    <li>
                      <def>Jaw</def>
                      <coverage>0.15</coverage>
                      <groups>
                        <li>Teeth</li>
                        <li>FullHead</li>
                        <li>Mouth</li>
                      </groups>
                    </li>
                    <li>
                      <def>TentacleBeastMouth</def>
                      <customLabel>mouth</customLabel>
                      <coverage>0.05</coverage>
                      <depth>Outside</depth>
                      <groups>
                        <li>Mouth</li>
                      </groups>
                    </li>
                  </parts>
                </li>
              </parts>
            </li>
            <li>
              <def>Shoulder</def>
              <customLabel>left shoulder</customLabel>
              <coverage>0.12</coverage>
              <height>Top</height>
              <groups>
                <li>Shoulders</li>
              </groups>
              <flipGraphic>true</flipGraphic>
              <parts>
                <li>
                  <def>Arm</def>
                  <customLabel>left arm</customLabel>
                  <coverage>0.77</coverage>
                  <groups>
                    <li>Arms</li>
                  </groups>
                </li>
              </parts>
            </li>
            <li>
              <def>Shoulder</def>
              <customLabel>right shoulder</customLabel>
              <coverage>0.12</coverage>
              <height>Top</height>
              <groups>
                <li>Shoulders</li>
              </groups>
              <parts>
                <li>
                  <def>Arm</def>
                  <customLabel>right arm</customLabel>
                  <coverage>0.77</coverage>
                  <groups>
                    <li>Arms</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>