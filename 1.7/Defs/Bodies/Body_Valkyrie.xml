<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Tentaculum body: ValkyrieBody -->
  <BodyDef>
    <defName>ValkyrieBody</defName>
    <corePart>
      <def>Torso</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Ribcage</def>
          <coverage>0.036</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Sternum</def>
          <coverage>0.015</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Pelvis</def>
          <coverage>0.025</coverage>
          <height>Bottom</height>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Spine</def>
          <coverage>0.025</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.025</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.020</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Neck</def>
          <coverage>0.10</coverage>
          <height>Top</height>
          <groups>
            <li>Neck</li>
          </groups>
          <parts>
            <li>
              <def>Head</def>
              <coverage>0.90</coverage>
              <groups>
                <li>UpperHead</li>
                <li>FullHead</li>
                <li>HeadAttackTool</li>
              </groups>
              <parts>
                <li>
                  <def>Brain</def>
                  <coverage>0.144</coverage>
                  <depth>Inside</depth>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>left sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                  <flipGraphic>true</flipGraphic>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>right sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>upper left sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>upper right sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>Jaw</def>
                  <coverage>0.15</coverage>
                  <groups>
                    <li>Teeth</li>
                    <li>FullHead</li>
                    <li>Mouth</li>
                  </groups>
                </li>
                <li>
                  <def>TentacleBeastMouth</def>
                  <customLabel>mouth</customLabel>
                  <coverage>0.05</coverage>
                  <depth>Outside</depth>
                  <groups>
                    <li>Mouth</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>left shoulder</customLabel>
          <coverage>0.11</coverage>
          <groups>
            <li>Shoulders</li>
          </groups>
          <flipGraphic>true</flipGraphic>
          <parts>
            <li>
              <def>Arm</def>
              <customLabel>left arm</customLabel>
              <coverage>0.77</coverage>
              <groups>
                <li>Arms</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>right shoulder</customLabel>
          <coverage>0.11</coverage>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>Arm</def>
              <customLabel>right arm</customLabel>
              <coverage>0.77</coverage>
              <groups>
                <li>Arms</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Leg</def>
          <customLabel>left leg</customLabel>
          <coverage>0.14</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
          <flipGraphic>true</flipGraphic>
        </li>
        <li>
          <def>Leg</def>
          <customLabel>right leg</customLabel>
          <coverage>0.14</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>Tentacle</def>
          <customLabel>upper left back tentacle</customLabel>
          <coverage>0.035</coverage>
          <height>Top</height>
          <depth>Outside</depth>
          <groups>
            <li>DefenderBackTentacles</li>
          </groups>
        </li>
        <li>
          <def>Tentacle</def>
          <customLabel>upper right back tentacle</customLabel>
          <coverage>0.035</coverage>
          <height>Top</height>
          <depth>Outside</depth>
          <flipGraphic>true</flipGraphic>
          <groups>
            <li>DefenderBackTentacles</li>
          </groups>
        </li>
        <li>
          <def>Tentacle</def>
          <customLabel>lower left back tentacle</customLabel>
          <coverage>0.035</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>DefenderBackTentacles</li>
          </groups>
        </li>
        <li>
          <def>Tentacle</def>
          <customLabel>lower right back tentacle</customLabel>
          <coverage>0.035</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <flipGraphic>true</flipGraphic>
          <groups>
            <li>DefenderBackTentacles</li>
          </groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>