<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Tentaculum body: StingerBody -->
  <BodyDef>
    <defName>StingerBody</defName>
    <corePart>
      <def>Body</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Spine</def>
          <coverage>0.02</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Head</def>
          <customLabel>bell</customLabel>
          <coverage>0.24</coverage>
          <height>Top</height>
          <groups>
            <li>FullHead</li>
            <li>UpperHead</li>
          </groups>
          <parts>
            <li>
              <def>Brain</def>
              <coverage>0.125</coverage>
              <depth>Inside</depth>
            </li>
            <li>
              <def>SensoryTentacle</def>
              <customLabel>left sensory tentacle</customLabel>
              <coverage>0.05</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>FullHead</li>
              </groups>
              <flipGraphic>true</flipGraphic>
            </li>
            <li>
              <def>SensoryTentacle</def>
              <customLabel>right sensory tentacle</customLabel>
              <coverage>0.05</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>FullHead</li>
              </groups>
            </li>
            <li>
              <def>TentacleBeastMouth</def>
              <customLabel>mouth</customLabel>
              <coverage>0.2</coverage>
              <groups>
                <li>Mouth</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>front left tentacle</customLabel>
          <coverage>0.025</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>front right tentacle</customLabel>
          <coverage>0.025</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>rear left tentacle</customLabel>
          <coverage>0.025</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>rear right tentacle</customLabel>
          <coverage>0.025</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>Tentacle</def>
          <customLabel>stinging tentacle</customLabel>
          <coverage>0.06</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
          <parts>
            <li>
              <def>TentacleStinger</def>
              <customLabel>venom stinger</customLabel>
              <coverage>0.2</coverage>
              <depth>Outside</depth>
              <groups>
                <li>Stinger</li>
              </groups>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>