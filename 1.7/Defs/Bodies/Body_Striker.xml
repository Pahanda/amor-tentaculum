<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Tentaculum body: StrikerBody -->
  <BodyDef>
    <defName>StrikerBody</defName>
    <corePart>
      <def>Body</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Brain</def>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Spine</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>SensoryTentacle</def>
          <customLabel>left sensory tentacle</customLabel>
          <coverage>0.02</coverage>
          <height>Top</height>
          <depth>Outside</depth>
        </li>
        <li>
          <def>SensoryTentacle</def>
          <customLabel>right sensory tentacle</customLabel>
          <coverage>0.02</coverage>
          <height>Top</height>
          <depth>Outside</depth>
        </li>
        <li>
          <def>SmallTentacle</def>
          <customLabel>mouth tentacle</customLabel>
          <coverage>0.12</coverage>
          <height>Middle</height>
          <depth>Outside</depth>
          <groups>
            <li>StrikerMouthTentacle</li>
          </groups>
          <parts>
            <li>
              <def>TentacleBeastMouth</def>
              <customLabel>mouth</customLabel>
              <coverage>0.3</coverage>
              <depth>Outside</depth>
              <groups>
                <li>Mouth</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>front left leg</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>front right leg</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>middle leg</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>rear left leg</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>rear right leg</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>