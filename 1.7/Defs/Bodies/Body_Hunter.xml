<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Tentaculum body: HunterBody -->
  <BodyDef>
    <defName>HunterBody</defName>
    <corePart>
      <def>Torso</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Ribcage</def>
          <coverage>0.036</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Sternum</def>
          <coverage>0.015</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Pelvis</def>
          <coverage>0.025</coverage>
          <height>Bottom</height>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Spine</def>
          <coverage>0.025</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.025</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.020</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Neck</def>
          <coverage>0.075</coverage>
          <height>Top</height>
          <groups>
            <li>Neck</li>
          </groups>
          <parts>
            <li>
              <def>TentacleBeastHead</def>
              <coverage>0.80</coverage>
              <groups>
                <li>UpperHead</li>
                <li>FullHead</li>
                <li>HeadAttackTool</li>
              </groups>
              <parts>
                <li>
                  <def>Brain</def>
                  <coverage>0.144</coverage>
                  <depth>Inside</depth>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>left sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>right sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>upper left sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>SensoryTentacle</def>
                  <customLabel>upper right sensory tentacle</customLabel>
                  <coverage>0.04</coverage>
                  <height>Top</height>
                  <depth>Outside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
                <li>
                  <def>TentacleBeastMouth</def>
                  <customLabel>mouth</customLabel>
                  <coverage>0.05</coverage>
                  <depth>Outside</depth>
                  <groups>
                    <li>Mouth</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>upper left shoulder</customLabel>
          <coverage>0.08</coverage>
          <height>Top</height>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>Tentacle</def>
              <customLabel>upper left arm</customLabel>
              <coverage>0.999</coverage>
              <groups>
                <li>Arms</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>upper right shoulder</customLabel>
          <coverage>0.08</coverage>
          <height>Top</height>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>Tentacle</def>
              <customLabel>upper right arm</customLabel>
              <coverage>0.999</coverage>
              <flipGraphic>true</flipGraphic>
              <groups>
                <li>Arms</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>lower left shoulder</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>Tentacle</def>
              <customLabel>lower left arm</customLabel>
              <coverage>0.999</coverage>
              <groups>
                <li>Arms</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>lower right shoulder</customLabel>
          <coverage>0.08</coverage>
          <height>Bottom</height>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>Tentacle</def>
              <customLabel>lower right arm</customLabel>
              <coverage>0.999</coverage>
              <flipGraphic>true</flipGraphic>
              <groups>
                <li>Arms</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>TentacleLeg</def>
          <customLabel>locomotion tentacle</customLabel>
          <coverage>0.12</coverage>
          <height>Bottom</height>
          <depth>Outside</depth>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>