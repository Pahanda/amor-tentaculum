<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Tentaculum body: SpawnerBody -->
  <BodyDef>
    <defName>SpawnerBody</defName>
    <corePart>
      <def>Body</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li>
          <def>Spine</def>
          <coverage>0.025</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.025</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>InsectHeart</def>
          <coverage>0.020</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>TentacleBeastHead</def>
          <coverage>0.4</coverage>
          <groups>
            <li>UpperHead</li>
            <li>FullHead</li>
            <li>HeadAttackTool</li>
          </groups>
          <parts>
            <li>
              <def>Brain</def>
              <coverage>0.144</coverage>
              <depth>Inside</depth>
            </li>
            <li>
              <def>SensoryTentacle</def>
              <customLabel>left sensory tentacle</customLabel>
              <coverage>0.04</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>FullHead</li>
              </groups>
            </li>
            <li>
              <def>SensoryTentacle</def>
              <customLabel>right sensory tentacle</customLabel>
              <coverage>0.04</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>FullHead</li>
              </groups>
            </li>
            <li>
              <def>SensoryTentacle</def>
              <customLabel>upper left sensory tentacle</customLabel>
              <coverage>0.04</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>FullHead</li>
              </groups>
            </li>
            <li>
              <def>SensoryTentacle</def>
              <customLabel>upper right sensory tentacle</customLabel>
              <coverage>0.04</coverage>
              <height>Top</height>
              <depth>Outside</depth>
              <groups>
                <li>FullHead</li>
              </groups>
            </li>
            <li>
              <def>TentacleBeastMouth</def>
              <customLabel>mouth</customLabel>
              <coverage>0.02</coverage>
              <depth>Outside</depth>
              <groups>
                <li>Mouth</li>
              </groups>
            </li>
            <li>
              <def>Tentacle</def>
              <customLabel>left mass of tentacles</customLabel>
              <coverage>0.208</coverage>
              <depth>Outside</depth>
              <groups>
                <li>SpawnerLeftTentacles</li>
              </groups>
            </li>
            <li>
              <def>Tentacle</def>
              <customLabel>right mass of tentacles</customLabel>
              <coverage>0.208</coverage>
              <depth>Outside</depth>
              <flipGraphic>true</flipGraphic>
              <groups>
                <li>SpawnerRightTentacles</li>
              </groups>
            </li>
            <li>
              <def>TentacleLeg</def>
              <coverage>0.13</coverage>
              <depth>Outside</depth>
              <groups>
                <li>Legs</li>
              </groups>
            </li>
            <li>
              <def>TentacleLeg</def>
              <coverage>0.13</coverage>
              <depth>Outside</depth>
              <groups>
                <li>Legs</li>
              </groups>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>
</Defs>