<Defs>

      <ThingDef ParentName="BodyPartBionicBase">
    <defName>TWombItem</defName>
    <label>in utero incubater</label>
    <description>An advanced artificial womb implant designed to aid in the incubation of Amor Matron eggs.</description>
    <descriptionHyperlinks>
      <RecipeDef>InstallTWombEnhance</RecipeDef>
    </descriptionHyperlinks>
    <statBases>
      <WorkToMake>26000</WorkToMake>
      <MarketValue>925</MarketValue>
    </statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedHealthItemBionic</unfinishedThingDef>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <researchPrerequisite>ATImplantHost</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Plasteel>10</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
  </ThingDef>

      <HediffDef ParentName="ImplantHediffBase">
    <hediffClass>HediffWithComps</hediffClass>
    <defName>TWombEnhanced</defName>
    <label>in utero incubater</label>
    <labelNoun>a in utero incubater</labelNoun>
    <description>An artificial implant inside the womb, aids in the incubation of Amor Matron eggs.</description>
    <descriptionHyperlinks><ThingDef>TWombItem</ThingDef></descriptionHyperlinks>
    <spawnThingOnRemoved>TWombItem</spawnThingOnRemoved>
        <comps>
      <li Class="EBSGFramework.HediffCompProperties_GiveOtherHediffPeriodically">
                <hediff>AmorQueenIncubation</hediff>
                <severity>0.08</severity>
                <interval>90000</interval>
                <bodyParts>
                 <li>Genitals</li>
                </bodyParts>
                <validSeverities>0.1</validSeverities>
                <multiplySeverityByParentSeverity>True</multiplySeverityByParentSeverity>
      </li>
    </comps>
  </HediffDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>InstallTWombEnhance</defName>
    <label>install in utero incubater</label>
    <description>Install an in utero incubater.</description>
    <descriptionHyperlinks>
      <ThingDef>TWombItem</ThingDef>
      <HediffDef>TWombEnhanced</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing utero incubater.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>TWombItem</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>TWombItem</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Genitals</li>
    </appliedOnFixedBodyParts>
    <addsHediff>TWombEnhanced</addsHediff>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
  </RecipeDef>

