<Defs>

   <HediffDef>
    <hediffClass>HediffWithComps</hediffClass>
    <defName>AmorSoothe</defName>
    <label>soothing pheromones</label>
    <description>This pawn is being affected by soothing phermones, emitted by a nearby Amor Tentculum creature. This increases the pawn's sex drive and psychic sensitivity.  It also lowers its receptiveness to pain.  All at a small penalty to consciousness.</description>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <painOffset>-0.9</painOffset>
        <statOffsets>
          <PsychicSensitivity>0.3</PsychicSensitivity>
          <Vulnerability>0.1</Vulnerability>
          <SexFrequency>0.1</SexFrequency>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>