					<Vulnerability>1</Vulnerability>
					<SexFrequency>1</SexFrequency>
				</statOffsets>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<setMax>0.4</setMax>
					</li>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.2</offset>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>0.8</minSeverity>
				<label>paralyzed</label>
				<statOffsets>
					<Vulnerability>2</Vulnerability>
					<SexFrequency>2</SexFrequency>
				</statOffsets>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<setMax>0.1</setMax>
					</li>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.3</offset>
					</li>
				</capMods>
			</li>
