<Defs>

	<HediffDef>
		<hediffClass>HediffWithComps</hediffClass>
		<defName>AmorQueenIncubation</defName>
		<label>Queen egg</label>
		<labelNoun>an amor queen egg</labelNoun>
		<defaultLabelColor>(240,189,234)</defaultLabelColor>
		<minSeverity>0</minSeverity>
		<initialSeverity>0.001</initialSeverity>
		<maxSeverity>1.5</maxSeverity>
		<description>An Amor Queen egg is being incubated by the Matron, and is growing inside her body. This process takes around 20 days (with default multipliers), and she will not enjoy it (although her Host body will adapt to suppress the pain over time).</description>
		<stages>
			<li>
				<minSeverity>0.001</minSeverity>
				<label>tiny</label>
				<statOffsets>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.1</minSeverity>
				<label>small</label>
				<painOffset>0.05</painOffset>
				<statOffsets>
					<MoveSpeed>-0.025</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.3</minSeverity>
				<label>large</label>
				<painOffset>0.075</painOffset>
				<statOffsets>
					<MoveSpeed>-0.05</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>huge</label>
				<painOffset>0.1</painOffset>
				<statOffsets>
					<MoveSpeed>-0.075</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.7</minSeverity>
				<label>enormous</label>
				<partEfficiencyOffset>-0.20</partEfficiencyOffset>
				<painOffset>0.125</painOffset>
				<statOffsets>
					<MoveSpeed>-0.01</MoveSpeed>
				</statOffsets>
			</li>
			<li>
				<minSeverity>0.98</minSeverity>
				<label>ready to deliver</label>
				<partEfficiencyOffset>-0.25</partEfficiencyOffset>
				<painOffset>0.15</painOffset>
				<statOffsets>
					<MoveSpeed>-0.15</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_GiveAbilityAtSeverity">
				<abilitiesAtSeverities>
					<li>
						<abilityDef>BirthMatronEgg</abilityDef>
						<validSeverity>0.98~999</validSeverity>
					</li>
				</abilitiesAtSeverities>
			</li>
			<li Class="AmorTentaculum.HediffCompProperties_MultipliedSeverityPerDay">
				<modSettingMultiplier>hostEggProductionSpeedFactor</modSettingMultiplier>
				<baseSeverityPerDay>0.05</baseSeverityPerDay>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>QueenEggLabor</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>Laying Egg (dilating)</label>
		<labelNoun>laying egg</labelNoun>
		<description>The Amor Matron is preparing to birth an Amor Queen egg. The labor process does not take a fixed amount of time, and the Host will progress through various stages of pain and contractions. Due to the size of the Egg, this will be quite debilitating.</description>
		<defaultLabelColor>(240,189,234)</defaultLabelColor>
		<blocksSleeping>true</blocksSleeping>
		<minSeverity>0</minSeverity>
		<initialSeverity>1</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<label>mild</label>
				<minSeverity>0.01</minSeverity>
				<painOffset>0.5</painOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<postFactor>0.4</postFactor>
					</li>
				</capMods>
			</li>
			<li>
				<label>intense</label>
				<minSeverity>0.3</minSeverity>
				<painOffset>0.75</painOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<postFactor>0.2</postFactor>
					</li>
				</capMods>
			</li>
			<li>
				<label>debilitating</label>
				<minSeverity>0.6</minSeverity>
				<painOffset>0.95</painOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<postFactor>0.0</postFactor>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>7500~35000</disappearsAfterTicks>
			</li>
			<li Class="HediffCompProperties_RandomizeStageWithInterval">
				<ticksToRandomize>5000~15000</ticksToRandomize>
				<notifyMessage>{PAWN_labelShort}'s labor went from {1} to {2}.</notifyMessage>
			</li>
			<li Class="HediffCompProperties_Effecter">
				<stateEffecter>LaborEarly</stateEffecter>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_HediffsOnRemoval">
				<hediffsToGive>
					<li>
						<hediffDef>QueenEggDelivery</hediffDef>
						<bodyParts>
							<li>Genitals</li>
						</bodyParts>
					</li>
				</hediffsToGive>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>QueenEggDelivery</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>Laying Egg (pushing)</label>
		<labelNoun>laying egg</labelNoun>
		<description>The Amor Matron is actively birthing an Amor Queen egg and can do nothing but focus on the delivery. The Queen Egg is coming!</description>
		<defaultLabelColor>(240,189,234)</defaultLabelColor>
		<blocksSleeping>true</blocksSleeping>
		<preventsCrawling>true</preventsCrawling>
		<stages>
			<li>
				<painOffset>0.85</painOffset>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<postFactor>0.0</postFactor>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>800~5000</disappearsAfterTicks>
			</li>
			<li Class="HediffCompProperties_Effecter">
				<stateEffecter>LaborLate</stateEffecter>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_CreateItems">
				<onRemovalThings>
					<li>
						<li>
							<thing>BigTEgg</thing>
						</li>
					</li>
				</onRemovalThings>
			</li>
		</comps>
	</HediffDef>
	
</Defs>