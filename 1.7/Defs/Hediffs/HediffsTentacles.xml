<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <HediffDef ParentName="DiseaseBase">
    <defName>vagrancy</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>body vagrancy</label>
    <labelNoun>vagrancy</labelNoun>
    <description>This creature is suffering from not being within a host body.</description>
    <minSeverity>0</minSeverity>
    <initialSeverity>0.01</initialSeverity>
    <lethalSeverity>2</lethalSeverity>
    <maxSeverity>2</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>initial</label>
        <painOffset>0.20</painOffset>
        <statOffsets>
          <MoveSpeed>-0.3</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>1.3</minSeverity>
        <label>minor</label>
        <painOffset>0.40</painOffset>
        <statOffsets>
          <MoveSpeed>-0.6</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>1.6</minSeverity>
        <label>major</label>
        <painOffset>0.60</painOffset>
        <statOffsets>
          <MoveSpeed>-0.9</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>1.9</minSeverity>
        <label>extreme</label>
        <painOffset>0.90</painOffset>
        <statOffsets>
          <MoveSpeed>-1.2</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>extreme</label>
        <painOffset>0.90</painOffset>
        <statOffsets>
          <MoveSpeed>-1.2</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.3</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>aggressive_nature</defName>
    <label>aggressive nature</label>
    <labelNoun>aggressive</labelNoun>
    <description>This creature is geneticly programed by the hive to be more aggressive in it's pursuit of intruders.</description>
    <stages>
      <li>
        <painOffset>-0.70</painOffset>
        <statOffsets>
          <MeleeCooldownFactor>-0.2</MeleeCooldownFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

	<!-- An hediff that can be applied to a tentacle (usually an Amor Internum) that will make its death silent (no letters) and not generate a corpse. -->
	<HediffDef>
		<defName>TentacleSacrifice</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<label>sacrificing</label>
		<labelNoun>sacrificing</labelNoun>
		<description>This tentacle is being consumed as a resource by a pawn.</description>
		<defaultLabelColor>(1,1,1)</defaultLabelColor>
		<minSeverity>0</minSeverity>
		<initialSeverity>0</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<stages>
			<li>
				<minSeverity>0.6</minSeverity>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
			<li>
				<minSeverity>1</minSeverity>
				<label>You shouldn't be seeing this...</label>
				<partEfficiencyOffset>-200</partEfficiencyOffset>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>100</severityPerDay>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_DestroyOnDeath" />
			<li Class="EBSGFramework.HediffCompProperties_PreventDeathNotifications" />
		</comps>
	</HediffDef>
	


</Defs>