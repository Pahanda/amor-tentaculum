  <HediffDef ParentName="ImplantHediffBase">
    <defName>Fworm</defName>
    <label>Feeding Tentacle</label>
    <descriptionHyperlinks><ThingDef>FeedWorm</ThingDef></descriptionHyperlinks>
    <renderNodeProperties>
            <li Class="PawnRenderNodeProperties_Eye">
              <workerClass>PawnRenderNodeWorker_HediffEye</workerClass>
              <texPath>Things/Pawns/Parts/Addons/TentacleM</texPath>
              <parentTagDef>Head</parentTagDef>
              <drawSize>1</drawSize>
              <colorType>Skin</colorType>
              <drawData>
                <defaultData>
                  <layer>70</layer>
                  <offset>(0, 0, -0.22)</offset>
                </defaultData>
                <dataWest>
                  <flip>true</flip>
                  <layer>-2</layer>
                  <offset>(-0.18, 0, -0.22)</offset>
                </dataWest>
                <dataEast>
                  <layer>-2</layer>
                  <offset>(0.18, 0, -0.22)</offset>
                </dataEast>
              </drawData>
            </li>
    </renderNodeProperties>
        <aptitudes>
      <Social>-20</Social>
         </aptitudes>
    <stages>
      <li>
        <makeImmuneTo>
          <li>GutWorms</li>
        </makeImmuneTo>
        <partEfficiencyOffset>-0.5</partEfficiencyOffset>
        <foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
          <capMods>
            <li>
              <capacity>Eating</capacity>
              <offset>5.25</offset>
            </li>
          </capMods>
      </li>
    </stages>
    <spawnThingOnRemoved>FeedWorm</spawnThingOnRemoved>
  </HediffDef>

</Defs>