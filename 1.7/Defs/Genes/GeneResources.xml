<Defs>      

	<!-- A Gene-Based NEED for tentacles.  Provided by Dynamic Resource Genes from the EBSG Framework. -->
	<GeneDef>
		<defName>HostTentacleNeed</defName>
		<label>Tentacle dependance</label>
		<description>Individuals who have been fully converted into tentacle hosts can no longer survive without a pool of tentacles in their body.  Those tentacles manage the host's basic body functions and provide physical structure, in addition to a physical and psychological dependence on the presence of the tentacles. They can use their stored pool of tentacles as a resource for abilities, but should that be depleted, they will die unless their stock is replenished.</description>
		<displayCategory>Miscellaneous</displayCategory>
		<iconPath>Things/Items/BrainLarve/WLarvae</iconPath>
		<geneClass>EBSGFramework.ResourceGene</geneClass>
		<resourceLossPerDay>0</resourceLossPerDay>
		<!--Negative means regeneration. A -1 would mean regenerating 100 per day-->
		<resourceGizmoThresholds>
			<li>0.25</li>
			<li>0.50</li>
			<li>0.75</li>
		</resourceGizmoThresholds>
		<resourceGizmoType>EBSGFramework.GeneGizmo_ResourceGene</resourceGizmoType>
		<!--If you have a GeneGizmo_Resource error, it's because you forgot this-->
		<showGizmoOnWorldView>false</showGizmoOnWorldView>
		<showGizmoWhenDrafted>true</showGizmoWhenDrafted>
		<resourceDescription>The amount of Amor Internum tentacles currently stored inside the host's body.</resourceDescription>
		<resourceLabel>tentacles</resourceLabel>
		<modExtensions>
			<li Class="EBSGFramework.DRGExtension">
				<!--Basics-->
				<isMainGene>True</isMainGene>
				<!--Tells the code that this is the gene handling the resource manipulation-->
				<!--Does as their name implies. If you want to see them in action, make the RGBs two very different colors-->
				<barColor>(203,35,227)</barColor>
				<barHighlightColor>(203,85,227)</barHighlightColor>
				<iconThing>MedTEgg</iconThing>
				<!--For Hemogen, this is that little pack at the top of the gizmo. For radiation, it's the first Uranium icon-->
				<!--Limit stuff-->
				<maximum>0.01</maximum>
				<maxStat>TStorage</maxStat>
				<!--The maximum shown in game is 100 times this, so a value of 10 is a maximum of 1,000-->
				<maxFactorStat>TStorageIncrease</maxFactorStat>
				<cravingHediff>NoTentacles</cravingHediff>
				<!--Optional. When the resource is out, this hediff starts climbing-->
				<overchargeHediff>FullOfTentacles</overchargeHediff>
				<!--Optional. When the resource is at the max, this hediff starts climbing-->
				<resourcePacksAllowed>False</resourcePacksAllowed>
				<!--True is the default value for this, and you should only set it to false if you don't have resource packs-->
			</li>
		</modExtensions>
	</GeneDef>

	<!-- This is the CRAVING hediff, applied when the resource runs out.  In our case, this is fatal - but can be corrected, in time. -->
	<HediffDef>
		<defName>NoTentacles</defName>
		<label>body collapse</label>
		<description>Due to the lack of tentacles in this host's body, they are collapsing in on themselves.  Replenish their Amor Internum capacity as soon as possible!</description>
		<hediffClass>EBSGFramework.Hediff_ResourceCraving</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 0.6)</defaultLabelColor>
		<initialSeverity>0.01</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<label>minor</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.9</setMax>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.3</offset>
					</li>
				</capMods>
			</li>
			<li>
				<label>moderate</label>
				<minSeverity>0.35</minSeverity>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.8</setMax>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.5</offset>
					</li>
				</capMods>
			</li>
			<li>
				<label>major</label>
				<minSeverity>0.7</minSeverity>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.5</setMax>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.7</offset>
					</li>
				</capMods>
			</li>
			<li>
				<label>extreme</label>
				<minSeverity>0.95</minSeverity>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0</setMax>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_SeverityFromResource">
				<severityPerHourEmpty>0.05</severityPerHourEmpty>
				<severityPerHourResource>-0.1</severityPerHourResource>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>60</ticks>
				<letterLabel>{0_labelShort} ran out of tentacles</letterLabel>
				<letterText>{0_labelShort} has run out of stored tentacles! They will collapse and die unless their capcity is replenished.</letterText>
				<letterType>HostRejection</letterType>
			</li>
		</comps>
	</HediffDef>

	<!-- This is the OVERCHARGE hediff, applied when resources are full.  In our case, it will begin to increment the Organ Elasticity hediff, permanently increasing pawn storage capacity. -->
	<HediffDef>
		<defName>FullOfTentacles</defName>
		<label>tentacle stuffed</label>
		<description>This Host has been pushed to their limit and is full to the brim with squirming tentacles. If they stay full, their body will eventually adapt - permanently increasing their storage capacity.</description>
		<hediffClass>EBSGFramework.Hediff_ResourceCraving</hediffClass>
		<defaultLabelColor>(0.6, 0.6, 0.6)</defaultLabelColor>
		<initialSeverity>0.01</initialSeverity>
		<maxSeverity>1</maxSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<label>overstuffed</label>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.5</offset>
					</li>
				</capMods>
				<painOffset>0.5</painOffset>
			</li>
			<li>
				<label>tight</label>
				<minSeverity>0.35</minSeverity>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.4</offset>
					</li>
				</capMods>
				<painOffset>0.4</painOffset>
			</li>
			<li>
				<label>acclimating</label>
				<minSeverity>0.7</minSeverity>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.3</offset>
					</li>
				</capMods>
				<painOffset>0.3</painOffset>
			</li>
		</stages>
		<comps>
			<li Class="EBSGFramework.HediffCompProperties_SeverityFromResource">
				<severityPerHourFull>0.05</severityPerHourFull>
				<severityPerHourResource>-1</severityPerHourResource>
				<mainResourceGene>HostTentacleNeed</mainResourceGene>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_CreateOtherHediffs">
				<hediffSets>
					<li>
						<hediffDef>OrganElasticity</hediffDef>
						<validSeverity>1</validSeverity>
						<severityPerDay>0.5</severityPerDay>
						<initialSeverity>1</initialSeverity>
					</li>
				</hediffSets>
			</li>
			<li Class="HediffCompProperties_MessageAfterTicks">
				<ticks>60</ticks>
				<letterLabel>{0_labelShort} overstuffed!</letterLabel>
				<letterText>{0_labelShort} has been overstuffed with tentacles. They will be in some pain while their body grows used to the sheer number swarming around inside them.  However, once the process completes, their storage capacity will permanently increase.</letterText>
				<letterType>HostPregnancy</letterType>
			</li>
			<li Class="HediffCompProperties_MessageOnRemoval">
				<messageOnNonZeroSeverity>true</messageOnNonZeroSeverity>
				<messageType>TaskCompletion</messageType>
				<message>{0} has grown accustomed to their new capacity for tentacles.</message>
				<onlyMessageForColonistsOrPrisoners>true</onlyMessageForColonistsOrPrisoners>
			</li>
			<li Class="EBSGFramework.HediffCompProperties_GiveOtherHediffPeriodically">
				<hediff>TentacleStorage</hediff>
				<severity>0.02</severity>
				<interval>15000</interval>
				<bodyParts>
					<li>Genitals</li>
				</bodyParts>
				<validSeverities>0.1</validSeverities>
			</li>
		</comps>
	</HediffDef>

