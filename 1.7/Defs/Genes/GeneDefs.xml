<Defs>

  <GeneCategoryDef>
    <defName>HiddenTentacleGenes</defName>
    <label>Hidden Tentacle-Specific Genes - Don't Use These</label>
    <displayPriorityInXenotype>-2102</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef ParentName="GeneGenitalTypeBase">
		<defName>RJWGenes_AmorTentacleInfestedFemaleGenitalia</defName>
		<label>tentacle inhabited genitalia (female)</label>
		<displayCategory>HiddenTentacleGenes</displayCategory>
		<description>Carriers of this gene have female genitalia permantly inhabited by tentacles.</description>
		<iconPath>Genes/Tentacle_Vagina</iconPath>
		<modExtensions>
			<li Class="RJW_Genes.GenitaliaTypeExtension">
				<penis>Penis</penis>
				<vagina>TVagina</vagina>
				<anus>TAnus</anus>
				<breasts>TBreasts</breasts>
			</li>
		</modExtensions>
		<displayOrderInCategory>802</displayOrderInCategory>
	</GeneDef>

	<GeneDef ParentName="GeneGenitalTypeBase">
		<defName>RJWGenes_AmorTentacleInfestedMaleGenitalia</defName>
		<label>tentacle inhabited genitalia (male)</label>
		<displayCategory>HiddenTentacleGenes</displayCategory>
		<description>Carriers of this gene have male genitalia permantly inhabited by tentacles.</description>
		<iconPath>Genes/Tentacle_Vagina</iconPath>
		<modExtensions>
			<li Class="RJW_Genes.GenitaliaTypeExtension">
				<penis>TPenis</penis>
				<vagina>Vagina</vagina>
				<anus>TAnus</anus>
				<breasts>TBreasts</breasts>
			</li>
		</modExtensions>
		<displayOrderInCategory>803</displayOrderInCategory>
	</GeneDef>

	<GeneDef>
		<defName>AmorMatronHostBody</defName>
		<label>Amor Matron</label>
		<displayCategory>HiddenTentacleGenes</displayCategory>
		<geneClass>EBSGFramework.HediffAdder</geneClass>
		<description>Carriers of this gene have a body that has been turned into a holding vessel for Amor Internum tentacles and a breeding nest for Amor Queen eggs.</description>
		<displayOrderInCategory>0.1</displayOrderInCategory>
		<abilities>
			<li>TentacleIngestAnus</li>
			<li>TentacleIngestVagina</li>
			<li>TentacleIngestStomach</li>
			<li>TentacleExpelVagina</li>
		</abilities>
		<modExtensions>
			<li Class="EBSGFramework.EBSGExtension">
				<hediffsToApply>
					<li>
						<hediff>AmorMatronSlimeProduction</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>1</severity>
						<bodyParts>
							<li>Genitals</li>
						</bodyParts>
					</li>
					<li>
						<hediff>AmorMatronPregnancy</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>0.01</severity>
					</li>
					<li>
						<hediff>tentaclegrowthV</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>1</severity>
						<bodyParts>
							<li>Genitals</li>
						</bodyParts>
					</li>
					<li>
						<hediff>TentacleStorageVagina</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>3</severity>
						<bodyParts>
							<li>Genitals</li>
						</bodyParts>
					</li>
					<li>
						<hediff>tentaclegrowthS</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>1</severity>
						<bodyParts>
							<li>Stomach</li>
						</bodyParts>
					</li>
					<li>
						<hediff>TentacleStorageStomach</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>2</severity>
						<bodyParts>
							<li>Stomach</li>
						</bodyParts>
					</li>
					<li>
						<hediff>tentaclegrowthA</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>1</severity>
						<bodyParts>
							<li>Anus</li>
						</bodyParts>
					</li>
					<li>
						<hediff>TentacleStorageAnus</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>2</severity>
						<bodyParts>
							<li>Anus</li>
						</bodyParts>
					</li>
					<li>
						<hediff>AMtentacle</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>1</severity>
						<bodyParts>
							<li>Anus</li>
						</bodyParts>
					</li>
					<li>
						<hediff>VMtentacle</hediff>
						<onlyIfNew>true</onlyIfNew>
						<severity>1</severity>
						<bodyParts>
							<li>Genitals</li>
						</bodyParts>
					</li>
				</hediffsToApply>
			</li>
		</modExtensions>
	</GeneDef>

	<HediffDef>
		<defName>OrganElasticity</defName>
		<label>organ elasticity</label>
		<description>The elasticity of the host's body is the main factor in determing how many tentacles they can hold. Can be increased by filling the body to the brim with tentacles, at which point the tentacles will further modify the body and stretch it further. Can also be increased with certain implants.\n\nNote that increasing the capacity beyond a certain point will make the host essentially immune to pain, which may not always be a good thing.  And there's no going back...</description>
		<isBad>False</isBad>
		<defaultLabelColor>(255,182,193)</defaultLabelColor>
		<everCurableByItem>False</everCurableByItem>
		<hediffClass>HediffWithComps</hediffClass>
		<scenarioCanAdd>False</scenarioCanAdd>
		<minSeverity>1</minSeverity>
		<maxSeverity>10</maxSeverity>
		<initialSeverity>1</initialSeverity>
		<stages>
			<li>
				<minSeverity>1</minSeverity>
				<label>slightly stretchy</label>
				<painOffset>-0.05</painOffset>
				<statOffsets>
					<TStorage>0.02</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>2</minSeverity>
				<label>a little stretchy</label>
				<painOffset>-0.1</painOffset>
				<statOffsets>
					<TStorage>0.06</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>3</minSeverity>
				<label>stretchy</label>
				<painOffset>-0.2</painOffset>
				<statOffsets>
					<TStorage>0.14</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>4</minSeverity>
				<label>very stretchy</label>
				<painOffset>-0.4</painOffset>
				<statOffsets>
					<TStorage>0.30</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>5</minSeverity>
				<label>elastic</label>
				<painOffset>-0.5</painOffset>
				<statOffsets>
					<TStorage>0.62</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>6</minSeverity>
				<label>very elastic</label>
				<painOffset>-0.75</painOffset>
				<statOffsets>
					<TStorage>1.26</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>7</minSeverity>
				<label>voracious tentacle gobbler</label>
				<painOffset>-0.9</painOffset>
				<statOffsets>
					<TStorage>2.3</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>8</minSeverity>
				<label>bottomless tentacle pit</label>
				<painOffset>-1.1</painOffset>
				<statOffsets>
					<TStorage>3.6</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>9</minSeverity>
				<label>tentacle black hole</label>
				<painOffset>-1.6</painOffset>
				<statOffsets>
					<TStorage>4.2</TStorage>
				</statOffsets>
			</li>
			<li>
				<minSeverity>10</minSeverity>
				<label>ludicrous</label>
				<painOffset>-2.5</painOffset>
				<statOffsets>
					<TStorage>5.0</TStorage>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

